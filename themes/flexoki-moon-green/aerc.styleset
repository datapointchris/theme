# Flexoki Moon Green - aerc styleset
# Generated from theme.yml
# Author: datapointchris

default.fg = #ddd8e8
default.bg = #08120b

# Selection is a raised surface, not an inverted block: aerc's own default
# reverses the row, which turns any saturated accent into a full-width glare
*.selected.bg = #2c3b2d
*.selected.fg = #d6fadc
*.selected.bold = true

border.fg = #6b7d6e
border.bg = #08120b

title.fg = #08120b
title.bg = #3aa99f
title.bold = true

header.fg = #3aa99f
header.bold = true

statusline_default.fg = #8f8a98
statusline_default.bg = #151f18
statusline_error.fg = #d14d41
statusline_error.bg = #151f18
statusline_error.bold = true
statusline_success.fg = #879a39
statusline_success.bg = #151f18

error.fg = #d14d41
error.bold = true
warning.fg = #da702c
success.fg = #879a39

# Read mail recedes to the muted ink so unread carries the weight on its own
msglist_default.fg = #ddd8e8
msglist_read.fg = #8f8a98
msglist_unread.fg = #d6fadc
msglist_unread.bold = true
msglist_answered.fg = #3aa99f
msglist_forwarded.fg = #3aa99f
msglist_flagged.fg = #d14d41
msglist_deleted.fg = #6b7d6e
msglist_marked.fg = #da702c
msglist_marked.bold = true
msglist_result.fg = #da702c
msglist_result.bold = true
msglist_gutter.fg = #6b7d6e
msglist_pill.fg = #08120b
msglist_pill.bg = #3aa99f

# Thread prefixes are structure, not content — keep them below the subject line
msglist_thread_context.fg = #8f8a98
msglist_thread_folded.fg = #3aa99f
msglist_thread_orphan.fg = #6b7d6e

dirlist_default.fg = #8f8a98
dirlist_unread.fg = #d6fadc
dirlist_unread.bold = true
dirlist_recent.fg = #879a39

tab.fg = #8f8a98
tab.bg = #151f18
tab.selected.fg = #08120b
tab.selected.bg = #3aa99f
tab.selected.bold = true

selector_default.fg = #ddd8e8
selector_focused.fg = #08120b
selector_focused.bg = #3aa99f
selector_chooser.fg = #3aa99f
selector_chooser.bold = true

completion_default.fg = #ddd8e8
completion_default.bg = #151f18
completion_description.fg = #6b7d6e
completion_gutter.bg = #151f18
completion_pill.bg = #6b7d6e

part_switcher.fg = #8f8a98
part_switcher.bg = #151f18
part_filename.fg = #3aa99f
part_mimetype.fg = #6b7d6e

# Underlined so a link stays identifiable where OSC 8 is stripped in transit
url.fg = #3aa99f
url.underline = true
signature.fg = #6b7d6e
spinner.fg = #3aa99f
stack.bg = #08120b

# Quote depth cycles through the palette so nested replies stay separable
quote_1.fg = #3aa99f
quote_2.fg = #879a39
quote_3.fg = #8b7ec8
quote_4.fg = #da702c
quote_x.fg = #6b7d6e

diff_meta.fg = #ddd8e8
diff_meta.bold = true
diff_chunk.fg = #3aa99f
diff_chunk_func.fg = #8b7ec8
diff_add.fg = #66800b
diff_del.fg = #af3029

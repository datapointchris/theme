# Flexoki Moon Green - abtop theme
# Generated from theme.yml
# Author: datapointchris

theme[main_bg]="#08120B"
theme[main_fg]="#DDD8E8"

# Panel titles
theme[title]="#3AA99F"

# Key hints, executing sessions, Bash calls
theme[hi_fg]="#3AA99F"

theme[selected_bg]="#2C3B2D"
theme[selected_fg]="#D6FADC"
theme[inactive_fg]="#6B7D6E"

# Labels and secondary text throughout
theme[graph_text]="#8F8A98"

# Unfilled meter cells
theme[meter_bg]="#6B7D6E"

# Thinking sessions, Edit calls, open ports
theme[proc_misc]="#879A39"

# Session ids, Read calls, MCP profiles
theme[session_id]="#D0A215"

# Rate-limited sessions and status messages
theme[status_fg]="#D14D41"
theme[warning_fg]="#DA702C"

theme[cpu_box]="#6B7D6E"
theme[mem_box]="#6B7D6E"
theme[net_box]="#6B7D6E"
theme[proc_box]="#6B7D6E"
theme[div_line]="#6B7D6E"

# Session badge per agent CLI
theme[agent_claude]="#DA702C"
theme[agent_codex]="#4385BE"
theme[agent_opencode]="#879A39"

# Context, quota and token-rate meters, by severity
theme[cpu_start]="#879A39"
theme[cpu_mid]="#DA702C"
theme[cpu_end]="#D14D41"

# Each session's context use, waiting sessions, port conflicts
theme[process_start]="#879A39"
theme[process_mid]="#DA702C"
theme[process_end]="#D14D41"

# Input tokens
theme[free_start]="#879A39"
theme[free_mid]="#3AA99F"
theme[free_end]="#D6FADC"

# Output tokens and per-project fill
theme[used_start]="#DA702C"
theme[used_mid]="#D14D41"
theme[used_end]="#D0A215"

# Cache reads and writes
theme[cached_start]="#D0A215"
theme[cached_mid]="#DA702C"
theme[cached_end]="#D6FADC"

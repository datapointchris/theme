{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#d3c6aa",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#859289",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7fbbb3",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1e2326",
    "background_color": "#7fbbb3",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#859289",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#83c092",
    "underline": true
  },
  "link_text": {
    "color": "#83c092",
    "bold": true
  },
  "image": {
    "color": "#d699b6",
    "underline": true
  },
  "image_text": {
    "color": "#9da9a0",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#83c092",
    "background_color": "#2e383c"
  },
  "code_block": {
    "color": "#d3c6aa",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#d3c6aa"
      },
      "error": {
        "color": "#d3c6aa",
        "background_color": "#e67e80"
      },
      "comment": {
        "color": "#859289",
        "italic": true
      },
      "comment_preproc": {
        "color": "#e67e80"
      },
      "keyword": {
        "color": "#e67e80"
      },
      "keyword_reserved": {
        "color": "#e67e80"
      },
      "keyword_namespace": {
        "color": "#e67e80"
      },
      "keyword_type": {
        "color": "#dbbc7f"
      },
      "operator": {
        "color": "#e69875"
      },
      "punctuation": {
        "color": "#859289"
      },
      "name": {
        "color": "#d3c6aa"
      },
      "name_builtin": {
        "color": "#a7c080"
      },
      "name_tag": {
        "color": "#83c092"
      },
      "name_attribute": {
        "color": "#a7c080"
      },
      "name_class": {
        "color": "#dbbc7f"
      },
      "name_constant": {
        "color": "#d699b6"
      },
      "name_decorator": {
        "color": "#d699b6"
      },
      "name_exception": {
        "color": "#dbbc7f"
      },
      "name_function": {
        "color": "#a7c080"
      },
      "literal_number": {
        "color": "#d699b6"
      },
      "literal_string": {
        "color": "#83c092"
      },
      "literal_string_escape": {
        "color": "#83c092"
      },
      "generic_deleted": {
        "color": "#e67e80"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#a7c080"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#83c092"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}

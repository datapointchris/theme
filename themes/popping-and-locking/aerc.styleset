# Popping and Locking - aerc styleset
# Generated from theme.yml
# Author: Hedinn Eiriksson

default.fg = #ebdbb2
default.bg = #181921

# Selection is a raised surface, not an inverted block: aerc's own default
# reverses the row, which turns any saturated accent into a full-width glare
*.selected.bg = #383637
*.selected.fg = #ebdbb2
*.selected.bold = true

border.fg = #ebdbb2
border.bg = #181921

title.fg = #181921
title.bg = #458588
title.bold = true

header.fg = #458588
header.bold = true

statusline_default.fg = #a89984
statusline_default.bg = #252631
statusline_error.fg = #cc5351
statusline_error.bg = #252631
statusline_error.bold = true
statusline_success.fg = #7fc678
statusline_success.bg = #252631

error.fg = #cc5351
error.bold = true
warning.fg = #e1656a
success.fg = #7fc678

# Read mail recedes to the muted ink so unread carries the weight on its own
msglist_default.fg = #ebdbb2
msglist_read.fg = #a89984
msglist_unread.fg = #ebdbb2
msglist_unread.bold = true
msglist_answered.fg = #689d6a
msglist_forwarded.fg = #689d6a
msglist_flagged.fg = #cc5351
msglist_deleted.fg = #928374
msglist_marked.fg = #e1656a
msglist_marked.bold = true
msglist_result.fg = #e1656a
msglist_result.bold = true
msglist_gutter.fg = #ebdbb2
msglist_pill.fg = #181921
msglist_pill.bg = #458588

# Thread prefixes are structure, not content — keep them below the subject line
msglist_thread_context.fg = #a89984
msglist_thread_folded.fg = #689d6a
msglist_thread_orphan.fg = #928374

dirlist_default.fg = #a89984
dirlist_unread.fg = #ebdbb2
dirlist_unread.bold = true
dirlist_recent.fg = #7fc678

tab.fg = #a89984
tab.bg = #252631
tab.selected.fg = #181921
tab.selected.bg = #458588
tab.selected.bold = true

selector_default.fg = #ebdbb2
selector_focused.fg = #181921
selector_focused.bg = #458588
selector_chooser.fg = #458588
selector_chooser.bold = true

completion_default.fg = #ebdbb2
completion_default.bg = #252631
completion_description.fg = #928374
completion_gutter.bg = #252631
completion_pill.bg = #ebdbb2

part_switcher.fg = #a89984
part_switcher.bg = #252631
part_filename.fg = #689d6a
part_mimetype.fg = #928374

spinner.fg = #458588

# url, signature, quote_* and diff_* are viewer-context objects and are rejected
# outright at the top level — aerc refuses to start on "unknown style object"
[viewer]
# Underlined so a link stays identifiable where OSC 8 is stripped in transit
url.fg = #689d6a
url.underline = true
header.fg = #458588
header.bold = true
signature.fg = #928374

# Quote depth cycles through the palette so nested replies stay separable
quote_1.fg = #689d6a
quote_2.fg = #98971a
quote_3.fg = #b16286
quote_4.fg = #e1656a
quote_x.fg = #928374

diff_meta.fg = #ebdbb2
diff_meta.bold = true
diff_chunk.fg = #689d6a
diff_chunk_func.fg = #b16286
diff_add.fg = #63ac6f
diff_del.fg = #cc5351

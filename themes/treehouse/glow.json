{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#786b53",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#504332",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#58859a",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#191919",
    "background_color": "#58859a",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#504332",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#b25a1e",
    "underline": true
  },
  "link_text": {
    "color": "#b25a1e",
    "bold": true
  },
  "image": {
    "color": "#97363d",
    "underline": true
  },
  "image_text": {
    "color": "#786b53",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#b25a1e",
    "background_color": "#252220"
  },
  "code_block": {
    "color": "#786b53",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#786b53"
      },
      "error": {
        "color": "#786b53",
        "background_color": "#b2270e"
      },
      "comment": {
        "color": "#504332",
        "italic": true
      },
      "comment_preproc": {
        "color": "#44a900"
      },
      "keyword": {
        "color": "#44a900"
      },
      "keyword_reserved": {
        "color": "#44a900"
      },
      "keyword_namespace": {
        "color": "#44a900"
      },
      "keyword_type": {
        "color": "#aa820c"
      },
      "operator": {
        "color": "#786b53"
      },
      "punctuation": {
        "color": "#504332"
      },
      "name": {
        "color": "#786b53"
      },
      "name_builtin": {
        "color": "#58859a"
      },
      "name_tag": {
        "color": "#b25a1e"
      },
      "name_attribute": {
        "color": "#aa820c"
      },
      "name_class": {
        "color": "#aa820c"
      },
      "name_constant": {
        "color": "#ed5d20"
      },
      "name_decorator": {
        "color": "#97363d"
      },
      "name_exception": {
        "color": "#aa820c"
      },
      "name_function": {
        "color": "#58859a"
      },
      "literal_number": {
        "color": "#97363d"
      },
      "literal_string": {
        "color": "#b25a1e"
      },
      "literal_string_escape": {
        "color": "#b25a1e"
      },
      "generic_deleted": {
        "color": "#b2270e"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#44a900"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#b25a1e"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}

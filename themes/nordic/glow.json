{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#BBC3D4",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#4C566A",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#81A1C1",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#242933",
    "background_color": "#81A1C1",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#4C566A",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#8FBCBB",
    "underline": true
  },
  "link_text": {
    "color": "#8FBCBB",
    "bold": true
  },
  "image": {
    "color": "#B48EAD",
    "underline": true
  },
  "image_text": {
    "color": "#60728A",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#A3BE8C",
    "background_color": "#2E3440"
  },
  "code_block": {
    "color": "#BBC3D4",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#BBC3D4"
      },
      "error": {
        "color": "#BBC3D4",
        "background_color": "#BF616A"
      },
      "comment": {
        "color": "#4C566A",
        "italic": true
      },
      "comment_preproc": {
        "color": "#d08770"
      },
      "keyword": {
        "color": "#d08770"
      },
      "keyword_reserved": {
        "color": "#d08770"
      },
      "keyword_namespace": {
        "color": "#d08770"
      },
      "keyword_type": {
        "color": "#ebcb8b"
      },
      "operator": {
        "color": "#c0c8d8"
      },
      "punctuation": {
        "color": "#60728a"
      },
      "name": {
        "color": "#BBC3D4"
      },
      "name_builtin": {
        "color": "#88C0D0"
      },
      "name_tag": {
        "color": "#8FBCBB"
      },
      "name_attribute": {
        "color": "#ebcb8b"
      },
      "name_class": {
        "color": "#ebcb8b"
      },
      "name_constant": {
        "color": "#be9db8"
      },
      "name_decorator": {
        "color": "#B48EAD"
      },
      "name_exception": {
        "color": "#ebcb8b"
      },
      "name_function": {
        "color": "#88C0D0"
      },
      "literal_number": {
        "color": "#be9db8"
      },
      "literal_string": {
        "color": "#A3BE8C"
      },
      "literal_string_escape": {
        "color": "#8FBCBB"
      },
      "generic_deleted": {
        "color": "#BF616A"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#A3BE8C"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#8FBCBB"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}

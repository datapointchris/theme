# Nordic - abtop theme
# Generated from theme.yml
# Author: AlexvZyl

theme[main_bg]="#242933"
theme[main_fg]="#BBC3D4"

# Panel titles
theme[title]="#8FBCBB"

# Key hints, executing sessions, Bash calls
theme[hi_fg]="#88C0D0"

theme[selected_bg]="#3B4252"
theme[selected_fg]="#D8DEE9"
theme[inactive_fg]="#4C566A"

# Labels and secondary text throughout
theme[graph_text]="#60728A"

# Unfilled meter cells
theme[meter_bg]="#4C566A"

# Thinking sessions, Edit calls, open ports
theme[proc_misc]="#A3BE8C"

# Session ids, Read calls, MCP profiles
theme[session_id]="#EBCB8B"

# Rate-limited sessions and status messages
theme[status_fg]="#C5727A"
theme[warning_fg]="#EBCB8B"

theme[cpu_box]="#191D24"
theme[mem_box]="#191D24"
theme[net_box]="#191D24"
theme[proc_box]="#191D24"
theme[div_line]="#191D24"

# Session badge per agent CLI
theme[agent_claude]="#D08770"
theme[agent_codex]="#81A1C1"
theme[agent_opencode]="#A3BE8C"

# Context, quota and token-rate meters, by severity
theme[cpu_start]="#A3BE8C"
theme[cpu_mid]="#EBCB8B"
theme[cpu_end]="#C5727A"

# Each session's context use, waiting sessions, port conflicts
theme[process_start]="#A3BE8C"
theme[process_mid]="#EBCB8B"
theme[process_end]="#C5727A"

# Input tokens
theme[free_start]="#A3BE8C"
theme[free_mid]="#8FBCBB"
theme[free_end]="#D8DEE9"

# Output tokens and per-project fill
theme[used_start]="#EBCB8B"
theme[used_mid]="#C5727A"
theme[used_end]="#EBCB8B"

# Cache reads and writes
theme[cached_start]="#EBCB8B"
theme[cached_mid]="#EBCB8B"
theme[cached_end]="#D8DEE9"

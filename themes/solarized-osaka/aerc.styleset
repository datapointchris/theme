# Solarized Osaka - aerc styleset
# Generated from theme.yml
# Author: Takuya Matsuyama (craftzdog)

default.fg = #839395
default.bg = #001419

# Selection is a raised surface, not an inverted block: aerc's own default
# reverses the row, which turns any saturated accent into a full-width glare
*.selected.bg = #073642
*.selected.fg = #a9b1b1
*.selected.bold = true

border.fg = #073642
border.bg = #001419

title.fg = #001419
title.bg = #268bd3
title.bold = true

header.fg = #268bd3
header.bold = true

statusline_default.fg = #657b83
statusline_default.bg = #002b36
statusline_error.fg = #db302d
statusline_error.bg = #002b36
statusline_error.bold = true
statusline_success.fg = #859900
statusline_success.bg = #002b36

error.fg = #db302d
error.bold = true
warning.fg = #b28500
success.fg = #859900

# Read mail recedes to the muted ink so unread carries the weight on its own
msglist_default.fg = #839395
msglist_read.fg = #657b83
msglist_unread.fg = #a9b1b1
msglist_unread.bold = true
msglist_answered.fg = #29a298
msglist_forwarded.fg = #29a298
msglist_flagged.fg = #db302d
msglist_deleted.fg = #586e75
msglist_marked.fg = #c94c16
msglist_marked.bold = true
msglist_result.fg = #b28500
msglist_result.bold = true
msglist_gutter.fg = #073642
msglist_pill.fg = #001419
msglist_pill.bg = #268bd3

# Thread prefixes are structure, not content — keep them below the subject line
msglist_thread_context.fg = #657b83
msglist_thread_folded.fg = #29a298
msglist_thread_orphan.fg = #586e75

dirlist_default.fg = #657b83
dirlist_unread.fg = #a9b1b1
dirlist_unread.bold = true
dirlist_recent.fg = #859900

tab.fg = #657b83
tab.bg = #002b36
tab.selected.fg = #001419
tab.selected.bg = #268bd3
tab.selected.bold = true

selector_default.fg = #839395
selector_focused.fg = #001419
selector_focused.bg = #268bd3
selector_chooser.fg = #268bd3
selector_chooser.bold = true

completion_default.fg = #839395
completion_default.bg = #002b36
completion_description.fg = #586e75
completion_gutter.bg = #002b36
completion_pill.bg = #073642

part_switcher.fg = #657b83
part_switcher.bg = #002b36
part_filename.fg = #29a298
part_mimetype.fg = #586e75

# Underlined so a link stays identifiable where OSC 8 is stripped in transit
url.fg = #268bd3
url.underline = true
signature.fg = #586e75
spinner.fg = #268bd3
stack.bg = #001419

# Quote depth cycles through the palette so nested replies stay separable
quote_1.fg = #29a298
quote_2.fg = #849900
quote_3.fg = #d23681
quote_4.fg = #c94c16
quote_x.fg = #586e75

diff_meta.fg = #839395
diff_meta.bold = true
diff_chunk.fg = #29a298
diff_chunk_func.fg = #d23681
diff_add.fg = #849900
diff_del.fg = #db302d

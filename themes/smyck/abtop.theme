# Smyck - abtop theme
# Generated from theme.yml
# Author: hukl

theme[main_bg]="#1B1B1B"
theme[main_fg]="#F7F7F7"

# Panel titles
theme[title]="#207383"

# Key hints, executing sessions, Bash calls
theme[hi_fg]="#207383"

theme[selected_bg]="#207483"
theme[selected_fg]="#F7F7F7"
theme[inactive_fg]="#7A7A7A"

# Labels and secondary text throughout
theme[graph_text]="#A1A1A1"

# Unfilled meter cells
theme[meter_bg]="#7A7A7A"

# Thinking sessions, Edit calls, open ports
theme[proc_misc]="#7DA900"

# Session ids, Read calls, MCP profiles
theme[session_id]="#C4A500"

# Rate-limited sessions and status messages
theme[status_fg]="#B84131"
theme[warning_fg]="#D6837C"

theme[cpu_box]="#7A7A7A"
theme[mem_box]="#7A7A7A"
theme[net_box]="#7A7A7A"
theme[proc_box]="#7A7A7A"
theme[div_line]="#7A7A7A"

# Session badge per agent CLI
theme[agent_claude]="#D6837C"
theme[agent_codex]="#62A3C4"
theme[agent_opencode]="#7DA900"

# Context, quota and token-rate meters, by severity
theme[cpu_start]="#7DA900"
theme[cpu_mid]="#D6837C"
theme[cpu_end]="#B84131"

# Each session's context use, waiting sessions, port conflicts
theme[process_start]="#7DA900"
theme[process_mid]="#D6837C"
theme[process_end]="#B84131"

# Input tokens
theme[free_start]="#7DA900"
theme[free_mid]="#207383"
theme[free_end]="#F7F7F7"

# Output tokens and per-project fill
theme[used_start]="#D6837C"
theme[used_mid]="#B84131"
theme[used_end]="#C4A500"

# Cache reads and writes
theme[cached_start]="#C4A500"
theme[cached_mid]="#D6837C"
theme[cached_end]="#F7F7F7"

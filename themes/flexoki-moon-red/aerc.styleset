# Flexoki Moon Red - aerc styleset
# Generated from theme.yml
# Author: datapointchris

default.fg = #f0e8dd
default.bg = #18090b

# Selection is a raised surface, not an inverted block: aerc's own default
# reverses the row, which turns any saturated accent into a full-width glare
*.selected.bg = #42322e
*.selected.fg = #ffeaec
*.selected.bold = true

border.fg = #8a6b60
border.bg = #18090b

title.fg = #18090b
title.bg = #3aa99f
title.bold = true

header.fg = #3aa99f
header.bold = true

statusline_default.fg = #b5967e
statusline_default.bg = #251a1a
statusline_error.fg = #d14d41
statusline_error.bg = #251a1a
statusline_error.bold = true
statusline_success.fg = #879a39
statusline_success.bg = #251a1a

error.fg = #d14d41
error.bold = true
warning.fg = #da702c
success.fg = #879a39

# Read mail recedes to the muted ink so unread carries the weight on its own
msglist_default.fg = #f0e8dd
msglist_read.fg = #b5967e
msglist_unread.fg = #ffeaec
msglist_unread.bold = true
msglist_answered.fg = #3aa99f
msglist_forwarded.fg = #3aa99f
msglist_flagged.fg = #d14d41
msglist_deleted.fg = #8a6b60
msglist_marked.fg = #da702c
msglist_marked.bold = true
msglist_result.fg = #da702c
msglist_result.bold = true
msglist_gutter.fg = #8a6b60
msglist_pill.fg = #18090b
msglist_pill.bg = #3aa99f

# Thread prefixes are structure, not content — keep them below the subject line
msglist_thread_context.fg = #b5967e
msglist_thread_folded.fg = #3aa99f
msglist_thread_orphan.fg = #8a6b60

dirlist_default.fg = #b5967e
dirlist_unread.fg = #ffeaec
dirlist_unread.bold = true
dirlist_recent.fg = #879a39

tab.fg = #b5967e
tab.bg = #251a1a
tab.selected.fg = #18090b
tab.selected.bg = #3aa99f
tab.selected.bold = true

selector_default.fg = #f0e8dd
selector_focused.fg = #18090b
selector_focused.bg = #3aa99f
selector_chooser.fg = #3aa99f
selector_chooser.bold = true

completion_default.fg = #f0e8dd
completion_default.bg = #251a1a
completion_description.fg = #8a6b60
completion_gutter.bg = #251a1a
completion_pill.bg = #8a6b60

part_switcher.fg = #b5967e
part_switcher.bg = #251a1a
part_filename.fg = #3aa99f
part_mimetype.fg = #8a6b60

# Underlined so a link stays identifiable where OSC 8 is stripped in transit
url.fg = #3aa99f
url.underline = true
signature.fg = #8a6b60
spinner.fg = #3aa99f
stack.bg = #18090b

# Quote depth cycles through the palette so nested replies stay separable
quote_1.fg = #3aa99f
quote_2.fg = #879a39
quote_3.fg = #8b7ec8
quote_4.fg = #da702c
quote_x.fg = #8a6b60

diff_meta.fg = #f0e8dd
diff_meta.bold = true
diff_chunk.fg = #3aa99f
diff_chunk_func.fg = #8b7ec8
diff_add.fg = #66800b
diff_del.fg = #af3029

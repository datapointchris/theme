{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#dcd7ba",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#727169",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7e9cd8",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#1f1f28",
    "background_color": "#7e9cd8",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#727169",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#6a9589",
    "underline": true
  },
  "link_text": {
    "color": "#6a9589",
    "bold": true
  },
  "image": {
    "color": "#957fb8",
    "underline": true
  },
  "image_text": {
    "color": "#c8c093",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#98bb6c",
    "background_color": "#16161d"
  },
  "code_block": {
    "color": "#dcd7ba",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#dcd7ba"
      },
      "error": {
        "color": "#dcd7ba",
        "background_color": "#c34043"
      },
      "comment": {
        "color": "#727169",
        "italic": true
      },
      "comment_preproc": {
        "color": "#957fb8"
      },
      "keyword": {
        "color": "#957fb8"
      },
      "keyword_reserved": {
        "color": "#957fb8"
      },
      "keyword_namespace": {
        "color": "#957fb8"
      },
      "keyword_type": {
        "color": "#7aa89f"
      },
      "operator": {
        "color": "#c0a36e"
      },
      "punctuation": {
        "color": "#9cabca"
      },
      "name": {
        "color": "#dcd7ba"
      },
      "name_builtin": {
        "color": "#7e9cd8"
      },
      "name_tag": {
        "color": "#6a9589"
      },
      "name_attribute": {
        "color": "#e6c384"
      },
      "name_class": {
        "color": "#7aa89f"
      },
      "name_constant": {
        "color": "#7fb4ca"
      },
      "name_decorator": {
        "color": "#957fb8"
      },
      "name_exception": {
        "color": "#7aa89f"
      },
      "name_function": {
        "color": "#7e9cd8"
      },
      "literal_number": {
        "color": "#d27e99"
      },
      "literal_string": {
        "color": "#98bb6c"
      },
      "literal_string_escape": {
        "color": "#6a9589"
      },
      "generic_deleted": {
        "color": "#c34043"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#76946a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#6a9589"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}

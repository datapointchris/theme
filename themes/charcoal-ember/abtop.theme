# Charcoal Ember - abtop theme
# Generated from theme.yml
# Author: datapointchris

theme[main_bg]="#1D1F21"
theme[main_fg]="#C5C8C6"

# Panel titles
theme[title]="#5FB3B3"

# Key hints, executing sessions, Bash calls
theme[hi_fg]="#4EB6FE"

theme[selected_bg]="#373B41"
theme[selected_fg]="#E0E0E0"
theme[inactive_fg]="#969896"

# Labels and secondary text throughout
theme[graph_text]="#969896"

# Unfilled meter cells
theme[meter_bg]="#969896"

# Thinking sessions, Edit calls, open ports
theme[proc_misc]="#60B45A"

# Session ids, Read calls, MCP profiles
theme[session_id]="#FFC400"

# Rate-limited sessions and status messages
theme[status_fg]="#C90D00"
theme[warning_fg]="#F79802"

theme[cpu_box]="#373B41"
theme[mem_box]="#373B41"
theme[net_box]="#373B41"
theme[proc_box]="#373B41"
theme[div_line]="#373B41"

# Session badge per agent CLI
theme[agent_claude]="#F79802"
theme[agent_codex]="#4EB6FE"
theme[agent_opencode]="#60B45A"

# Context, quota and token-rate meters, by severity
theme[cpu_start]="#60B45A"
theme[cpu_mid]="#F79802"
theme[cpu_end]="#C90D00"

# Each session's context use, waiting sessions, port conflicts
theme[process_start]="#60B45A"
theme[process_mid]="#F79802"
theme[process_end]="#C90D00"

# Input tokens
theme[free_start]="#60B45A"
theme[free_mid]="#5FB3B3"
theme[free_end]="#E0E0E0"

# Output tokens and per-project fill
theme[used_start]="#F79802"
theme[used_mid]="#C90D00"
theme[used_end]="#FFC400"

# Cache reads and writes
theme[cached_start]="#FFC400"
theme[cached_mid]="#F79802"
theme[cached_end]="#E0E0E0"

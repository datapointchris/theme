# Gruvbox Dark Hard - aerc styleset
# Generated from theme.yml
# Author: morhetz (https://github.com/morhetz/gruvbox)

default.fg = #ebdbb2
default.bg = #1d2021

# Selection is a raised surface, not an inverted block: aerc's own default
# reverses the row, which turns any saturated accent into a full-width glare
*.selected.bg = #665c54
*.selected.fg = #d5c4a1
*.selected.bold = true

border.fg = #504945
border.bg = #1d2021

title.fg = #1d2021
title.bg = #83a598
title.bold = true

header.fg = #83a598
header.bold = true

statusline_default.fg = #928374
statusline_default.bg = #3c3836
statusline_error.fg = #fb4934
statusline_error.bg = #3c3836
statusline_error.bold = true
statusline_success.fg = #b8bb26
statusline_success.bg = #3c3836

error.fg = #fb4934
error.bold = true
warning.fg = #fe8019
success.fg = #b8bb26

# Read mail recedes to the muted ink so unread carries the weight on its own
msglist_default.fg = #ebdbb2
msglist_read.fg = #928374
msglist_unread.fg = #d5c4a1
msglist_unread.bold = true
msglist_answered.fg = #8ec07c
msglist_forwarded.fg = #8ec07c
msglist_flagged.fg = #fb4934
msglist_deleted.fg = #665c54
msglist_marked.fg = #fe8019
msglist_marked.bold = true
msglist_result.fg = #fe8019
msglist_result.bold = true
msglist_gutter.fg = #504945
msglist_pill.fg = #1d2021
msglist_pill.bg = #83a598

# Thread prefixes are structure, not content — keep them below the subject line
msglist_thread_context.fg = #928374
msglist_thread_folded.fg = #8ec07c
msglist_thread_orphan.fg = #665c54

dirlist_default.fg = #928374
dirlist_unread.fg = #d5c4a1
dirlist_unread.bold = true
dirlist_recent.fg = #b8bb26

tab.fg = #928374
tab.bg = #3c3836
tab.selected.fg = #1d2021
tab.selected.bg = #83a598
tab.selected.bold = true

selector_default.fg = #ebdbb2
selector_focused.fg = #1d2021
selector_focused.bg = #83a598
selector_chooser.fg = #83a598
selector_chooser.bold = true

completion_default.fg = #ebdbb2
completion_default.bg = #3c3836
completion_description.fg = #665c54
completion_gutter.bg = #3c3836
completion_pill.bg = #504945

part_switcher.fg = #928374
part_switcher.bg = #3c3836
part_filename.fg = #8ec07c
part_mimetype.fg = #665c54

spinner.fg = #83a598

# url, signature, quote_* and diff_* are viewer-context objects and are rejected
# outright at the top level — aerc refuses to start on "unknown style object"
[viewer]
# Underlined so a link stays identifiable where OSC 8 is stripped in transit
url.fg = #83a598
url.underline = true
header.fg = #83a598
header.bold = true
signature.fg = #665c54

# Quote depth cycles through the palette so nested replies stay separable
quote_1.fg = #8ec07c
quote_2.fg = #b8bb26
quote_3.fg = #d3869b
quote_4.fg = #fe8019
quote_x.fg = #665c54

diff_meta.fg = #ebdbb2
diff_meta.bold = true
diff_chunk.fg = #8ec07c
diff_chunk_func.fg = #d3869b
diff_add.fg = #b8bb26
diff_del.fg = #fb4934

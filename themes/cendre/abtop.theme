# Cendre - abtop theme
# Generated from theme.yml
# Author: Aejkatappaja

theme[main_bg]="#171311"
theme[main_fg]="#E6D5C2"

# Panel titles
theme[title]="#20C9CB"

# Key hints, executing sessions, Bash calls
theme[hi_fg]="#EA9875"

theme[selected_bg]="#2F1E17"
theme[selected_fg]="#E6D5C2"
theme[inactive_fg]="#73665B"

# Labels and secondary text throughout
theme[graph_text]="#A09384"

# Unfilled meter cells
theme[meter_bg]="#73665B"

# Thinking sessions, Edit calls, open ports
theme[proc_misc]="#43B16A"

# Session ids, Read calls, MCP profiles
theme[session_id]="#FCBA81"

# Rate-limited sessions and status messages
theme[status_fg]="#D25780"
theme[warning_fg]="#F4A21C"

theme[cpu_box]="#362F2C"
theme[mem_box]="#362F2C"
theme[net_box]="#362F2C"
theme[proc_box]="#362F2C"
theme[div_line]="#362F2C"

# Session badge per agent CLI
theme[agent_claude]="#EA9875"
theme[agent_codex]="#4E89A2"
theme[agent_opencode]="#99AF6B"

# Context, quota and token-rate meters, by severity
theme[cpu_start]="#43B16A"
theme[cpu_mid]="#F4A21C"
theme[cpu_end]="#D25780"

# Each session's context use, waiting sessions, port conflicts
theme[process_start]="#43B16A"
theme[process_mid]="#F4A21C"
theme[process_end]="#D25780"

# Input tokens
theme[free_start]="#43B16A"
theme[free_mid]="#20C9CB"
theme[free_end]="#E6D5C2"

# Output tokens and per-project fill
theme[used_start]="#F4A21C"
theme[used_mid]="#D25780"
theme[used_end]="#FCBA81"

# Cache reads and writes
theme[cached_start]="#FCBA81"
theme[cached_mid]="#F4A21C"
theme[cached_end]="#E6D5C2"

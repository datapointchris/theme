{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e6eaea",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#6d7f8b",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#5a93aa",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#152528",
    "background_color": "#5a93aa",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#6d7f8b",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#a1cdd8",
    "underline": true
  },
  "link_text": {
    "color": "#a1cdd8",
    "bold": true
  },
  "image": {
    "color": "#ad5c7c",
    "underline": true
  },
  "image_text": {
    "color": "#587b7b",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#7aa4a1",
    "background_color": "#1d3337"
  },
  "code_block": {
    "color": "#e6eaea",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#e6eaea"
      },
      "error": {
        "color": "#e6eaea",
        "background_color": "#e85c51"
      },
      "comment": {
        "color": "#6d7f8b",
        "italic": true
      },
      "comment_preproc": {
        "color": "#ad5c7c"
      },
      "keyword": {
        "color": "#ad5c7c"
      },
      "keyword_reserved": {
        "color": "#ad5c7c"
      },
      "keyword_namespace": {
        "color": "#ad5c7c"
      },
      "keyword_type": {
        "color": "#fda47f"
      },
      "operator": {
        "color": "#cbd9d8"
      },
      "punctuation": {
        "color": "#cbd9d8"
      },
      "name": {
        "color": "#e6eaea"
      },
      "name_builtin": {
        "color": "#73a3b7"
      },
      "name_tag": {
        "color": "#a1cdd8"
      },
      "name_attribute": {
        "color": "#73a3b7"
      },
      "name_class": {
        "color": "#fda47f"
      },
      "name_constant": {
        "color": "#ff9664"
      },
      "name_decorator": {
        "color": "#ad5c7c"
      },
      "name_exception": {
        "color": "#fda47f"
      },
      "name_function": {
        "color": "#73a3b7"
      },
      "literal_number": {
        "color": "#ff8349"
      },
      "literal_string": {
        "color": "#7aa4a1"
      },
      "literal_string_escape": {
        "color": "#a1cdd8"
      },
      "generic_deleted": {
        "color": "#e85c51"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#7aa4a1"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#a1cdd8"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}

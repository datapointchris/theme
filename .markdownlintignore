# Generated by go-semantic-release on every release, which writes a blank line
# after each version heading. Linting it means --fix strips those on the next
# commit and the release puts them back — permanent churn over formatting no
# one authors by hand.
CHANGELOG.md

# Experiment reports written by analysis/experiments/*.py — the table separator
# style is emitted by the generator (canonical_comparison.py:671), so linting
# these means editing output that the next run overwrites.
analysis/**

# Planning documents - ephemeral, not committed
.planning/**

# Auto-generated noise directories (gitignored)
debug/**
file-history/**
plans/**
shell-snapshots/**
sessions/**
